// !!! This is a file automatically generated by hipify!!!
// MLA/MHA decode stage2 softmax reduce kernel - HIP C++ replacement for Triton _fwd_kernel_stage2
// Used by decode_attention_fwd_grouped_rope (the ROCm MLA decode path)
//
// For each (batch, head): reduce partial outputs across KV splits using online softmax

#include <hip/hip_runtime.h>
#include <hip/hip_bf16.h>
#include <hip/hip_fp16.h>
#include <torch/extension.h>
#include <ATen/hip/HIPContext.h>
#include <c10/hip/HIPStream.h>
#include <type_traits>

template <typename OutT, int Lv, int MAX_KV_SPLITS>
__global__ void decode_stage2_reduce_kernel(
    const float* __restrict__ Mid_O,     // [batch, head, max_kv_splits, Lv]
    const float* __restrict__ Mid_lse,   // [batch, head, max_kv_splits, 1]
    OutT* __restrict__ O,                // [batch, head, Lv]
    const float v_scale,
    const int32_t* __restrict__ kv_indptr,
    const int32_t* __restrict__ num_kv_splits,  // [batch]
    int64_t stride_mid_ob,
    int64_t stride_mid_oh,
    int64_t stride_mid_os,
    int64_t stride_obs,
    int64_t stride_oh,
    int min_block_kv
) {
    const int cur_batch = blockIdx.x;
    const int cur_head = blockIdx.y;
    const int tid = threadIdx.x;

    const int cur_batch_seq_len = kv_indptr[cur_batch + 1] - kv_indptr[cur_batch];
    const int kv_splits = num_kv_splits[cur_batch];

    // kv_len_per_split: round up to min_block_kv
    const int raw_per_split = (cur_batch_seq_len + kv_splits - 1) / kv_splits;
    const int kv_len_per_split = ((raw_per_split + min_block_kv - 1) / min_block_kv) * min_block_kv;

    const int64_t base_v = (int64_t)cur_batch * stride_mid_ob + (int64_t)cur_head * stride_mid_oh;
    const int64_t base_lse = base_v / Lv;

    for (int d = tid; d < Lv; d += blockDim.x) {
        float e_sum = 0.0f;
        float e_max = -INFINITY;
        float acc = 0.0f;

        for (int split_id = 0; split_id < MAX_KV_SPLITS; split_id++) {
            int split_kv_start = kv_len_per_split * split_id;
            int split_kv_end = min(split_kv_start + kv_len_per_split, cur_batch_seq_len);

            if (split_kv_end > split_kv_start) {
                float tv = Mid_O[base_v + (int64_t)split_id * stride_mid_os + d];
                float tlogic = Mid_lse[base_lse + (int64_t)split_id * stride_mid_os / Lv];

                float n_e_max = fmaxf(tlogic, e_max);
                float old_scale = expf(e_max - n_e_max);
                float exp_logic = expf(tlogic - n_e_max);
                acc = acc * old_scale + exp_logic * tv;
                e_sum = e_sum * old_scale + exp_logic;
                e_max = n_e_max;
            }
        }

        float result = (acc / e_sum) * v_scale;
        int64_t out_idx = (int64_t)cur_batch * stride_obs + (int64_t)cur_head * stride_oh + d;
        if constexpr (std::is_same_v<OutT, __hip_bfloat16>) {
            O[out_idx] = __float2bfloat16(result);
        } else if constexpr (std::is_same_v<OutT, __half>) {
            O[out_idx] = __float2half(result);
        } else {
            O[out_idx] = result;
        }
    }
}

void decode_stage2_reduce(
    torch::Tensor Mid_O,
    torch::Tensor Mid_lse,
    torch::Tensor O,
    float v_scale,
    torch::Tensor kv_indptr,
    torch::Tensor num_kv_splits,
    int64_t stride_mid_ob,
    int64_t stride_mid_oh,
    int64_t stride_mid_os,
    int64_t stride_obs,
    int64_t stride_oh,
    int max_kv_splits,
    int min_block_kv,
    int batch,
    int head_num,
    int v_head_dim
) {
    dim3 grid(batch, head_num);
    int block_size = (v_head_dim <= 128) ? 128 : (v_head_dim <= 256) ? 256 : 512;
    dim3 block(block_size);
    auto stream = c10::hip::getCurrentHIPStream().stream();

    // Dispatch on output dtype, Lv, and MAX_KV_SPLITS
    // For DeepSeek: Lv=128 (kv_lora_rank after absorption), common max_kv_splits: 2, 4, 8, 16
    #define LAUNCH(OutT, LV_VAL, MKS) \
       hipLaunchKernelGGL(( decode_stage2_reduce_kernel<OutT, LV_VAL, MKS>), dim3(grid), dim3(block), 0, stream,  \
            Mid_O.data_ptr<float>(), Mid_lse.data_ptr<float>(), \
            reinterpret_cast<OutT*>(O.data_ptr()), \
            v_scale, kv_indptr.data_ptr<int32_t>(), num_kv_splits.data_ptr<int32_t>(), \
            stride_mid_ob, stride_mid_oh, stride_mid_os, \
            stride_obs, stride_oh, min_block_kv)

    #define DISPATCH_MKS(OutT, LV_VAL) \
        if (max_kv_splits <= 2) { LAUNCH(OutT, LV_VAL, 2); } \
        else if (max_kv_splits <= 4) { LAUNCH(OutT, LV_VAL, 4); } \
        else if (max_kv_splits <= 8) { LAUNCH(OutT, LV_VAL, 8); } \
        else if (max_kv_splits <= 16) { LAUNCH(OutT, LV_VAL, 16); } \
        else if (max_kv_splits <= 32) { LAUNCH(OutT, LV_VAL, 32); } \
        else if (max_kv_splits <= 64) { LAUNCH(OutT, LV_VAL, 64); } \
        else { AT_ERROR("Unsupported max_kv_splits: ", max_kv_splits); }

    #define DISPATCH_LV(OutT) \
        if (v_head_dim <= 128) { DISPATCH_MKS(OutT, 128); } \
        else if (v_head_dim <= 256) { DISPATCH_MKS(OutT, 256); } \
        else if (v_head_dim <= 512) { DISPATCH_MKS(OutT, 512); } \
        else if (v_head_dim <= 576) { DISPATCH_MKS(OutT, 576); } \
        else { AT_ERROR("Unsupported v_head_dim: ", v_head_dim); }

    if (O.scalar_type() == at::ScalarType::Float) {
        DISPATCH_LV(float);
    } else if (O.scalar_type() == at::ScalarType::BFloat16) {
        DISPATCH_LV(__hip_bfloat16);
    } else if (O.scalar_type() == at::ScalarType::Half) {
        DISPATCH_LV(__half);
    } else {
        AT_ERROR("Unsupported output dtype");
    }

    #undef LAUNCH
    #undef DISPATCH_MKS
    #undef DISPATCH_LV
}

PYBIND11_MODULE(decode_stage2_reduce_hip, m) {
    m.def("decode_stage2_reduce", &decode_stage2_reduce, "Decode stage2 softmax reduce (HIP)");
}
