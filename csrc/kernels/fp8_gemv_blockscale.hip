// !!! This is a file automatically generated by hipify!!!
// Fused FP8 blockscale GEMV — V8b (best standalone perf)
// Warp-per-output: each warp handles 1 output, 64 lanes read consecutive K
// [N, K] row-major weight: w[n, k] contiguous along K per row
// Single warp reduce at end (not per K-group)
// Hardware v_cvt_f32_fp8 for FP8→F32

#include <hip/hip_runtime.h>
#include <hip/hip_bfloat16.h>
#include <hip/amd_detail/amd_hip_ocp_fp.hpp>
#include <torch/extension.h>
#include <ATen/hip/HIPContext.h>
#include <ATen/hip/impl/HIPGuardImplMasqueradingAsCUDA.h>

__device__ __forceinline__ float warp_reduce_sum_64(float val) {
    for (int offset = 32; offset > 0; offset >>= 1)
        val += __shfl_xor(val, offset, 64);
    return val;
}

template <int WARPS_PER_BLOCK>
__global__ void __launch_bounds__(WARPS_PER_BLOCK * 64, 2)
fp8_gemv_warp_per_output(
    const uint8_t* __restrict__ x_fp8,     // [K]
    const uint8_t* __restrict__ w_fp8,     // [N, K] row-major
    const float* __restrict__ x_scale,     // [K/128]
    const float* __restrict__ w_scale,     // [N/128, K/128]
    __hip_bfloat16* __restrict__ out,      // [N]
    const int N, const int K)
{
    constexpr int WARP_SIZE = 64;
    constexpr int K_GROUP = 128;
    const int warp_id = threadIdx.x / WARP_SIZE;
    const int lane_id = threadIdx.x % WARP_SIZE;
    const int n_global = blockIdx.x * WARPS_PER_BLOCK + warp_id;
    if (n_global >= N) return;

    const int k_groups = K / K_GROUP;
    const int n_group = n_global / 128;
    const int w_scale_stride_n = k_groups;
    const uint8_t* w_row = w_fp8 + (size_t)n_global * K;

    float lane_acc = 0.0f;

    for (int kg = 0; kg < k_groups; kg++)
    {
        const int k_base = kg * K_GROUP;
        const float scale = x_scale[kg] * w_scale[n_group * w_scale_stride_n + kg];

        // Each lane reads 2 consecutive bytes (128/64=2 per lane)
        // All 64 lanes cover k_base..k_base+127
        // Vectorized 2-byte load from weight row (contiguous along K)
        int k0 = k_base + lane_id * 2;
        uint16_t w_pair = *reinterpret_cast<const uint16_t*>(w_row + k0);
        uint16_t x_pair = *reinterpret_cast<const uint16_t*>(x_fp8 + k0);

        float w0 = __builtin_amdgcn_cvt_f32_fp8(static_cast<uint32_t>(w_pair & 0xFF), 0);
        float w1 = __builtin_amdgcn_cvt_f32_fp8(static_cast<uint32_t>((w_pair >> 8) & 0xFF), 0);
        float x0 = __builtin_amdgcn_cvt_f32_fp8(static_cast<uint32_t>(x_pair & 0xFF), 0);
        float x1 = __builtin_amdgcn_cvt_f32_fp8(static_cast<uint32_t>((x_pair >> 8) & 0xFF), 0);

        lane_acc += (w0 * x0 + w1 * x1) * scale;
    }

    float result = warp_reduce_sum_64(lane_acc);
    if (lane_id == 0)
        out[n_global] = __float2bfloat16(result);
}

torch::Tensor fp8_gemv_blockscale(
    torch::Tensor x, torch::Tensor w, torch::Tensor x_scale,
    torch::Tensor w_scale, torch::Tensor output)
{
    const int N = w.size(0), K = w.size(1);
    auto stream = c10::hip::getCurrentHIPStream().stream();
    constexpr int WPB = 4;
   hipLaunchKernelGGL(( fp8_gemv_warp_per_output<WPB>), dim3((N+WPB-1)/WPB), dim3(WPB*64), 0, stream, 
        reinterpret_cast<const uint8_t*>(x.data_ptr()),
        reinterpret_cast<const uint8_t*>(w.data_ptr()),
        x_scale.data_ptr<float>(), w_scale.data_ptr<float>(),
        reinterpret_cast<__hip_bfloat16*>(output.data_ptr()), N, K);
    return output;
}

TORCH_LIBRARY(fp8_gemv, m) {
    m.def("blockscale(Tensor x, Tensor w, Tensor x_scale, Tensor w_scale, Tensor(a!) output) -> Tensor(a!)");
}
TORCH_LIBRARY_IMPL(fp8_gemv, CUDA, m) { m.impl("blockscale", &fp8_gemv_blockscale); }
PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def("fp8_gemv_blockscale", &fp8_gemv_blockscale); }
